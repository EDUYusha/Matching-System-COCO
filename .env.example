# ---------------------------------------------------------------------------
# coco-v3 environment
#
# Nothing secret is committed. The Rails original hard-coded the LINE channel
# token, Twilio auth token and Axes payment key in config/initializers/
# constants.rb — those values are NOT carried over. Issue fresh credentials and
# put them here; treat the ones in the old file as leaked.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- database / queue ---
# A database of its own; coco-v2 keeps coco_dev untouched.
DATABASE_URL=postgresql://coco:coco@localhost:5432/coco_v3
# Redis database 1, so these queues never collide with coco-v2's on database 0.
REDIS_URL=redis://localhost:6379/1

# --- server ---
PORT=3000
HOST=0.0.0.0
# One origin serves the pages, the API and the websocket.
PUBLIC_URL=http://localhost:3000
HOST_PREFIX=http://localhost:3000

# --- secrets ---
SECRET_KEY_BASE=change-me-to-a-long-random-string-at-least-64-characters-long-0000
ADMIN_SECRET_KEY_BASE=change-me-too-also-long-and-random-0000000000000000000000000000000

# --- internal api allow-list (InternalApi::BaseController#must_be_local_request) ---
RAILS_LOCAL_ZONE=10.0.0.0/8,172.17.0.0/16,192.168.0.0/16

# --- uploads ---
UPLOADS_DIR=./uploads
CAST_PICTURES_DIR=./uploads/cast_pictures

# --- LINE (sns_* in the original) ---
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- Twilio SMS (sms_* in the original) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Axes payment gateway ---
PAYMENT_CARD_REGISTER_URL=https://gw.axes-payment.com/cgi-bin/secure.cgi
PAYMENT_PROCESSING_URL=https://gw.axes-payment.com/cgi-bin/secure.cgi
PAYMENT_REQ_URL=https://gw.axes-payment.com/cgi-bin/secure/api.cgi
PAYMENT_CLIENT_IP=
PAYMENT_ZKEY=

# --- Firebase push ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- mail ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=no-reply@co-co.today
ADMIN_EMAIL_ADDRESSES=
