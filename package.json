{
  "name": "coco-v3",
  "private": true,
  "version": "1.0.0",
  "description": "TOLA / co-co.today \u2014 full-stack Next.js rebuild (light theme)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env --clear-screen=false server.ts",
    "dev:next": "next dev",
    "dev:worker": "tsx watch --env-file=.env worker/runner.ts",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production tsx --env-file=.env server.ts",
    "start:worker": "NODE_ENV=production tsx --env-file=.env worker/runner.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "@tanstack/react-query": "^5.66.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.39.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "hashids": "^2.3.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "next": "^16.3.4",
    "nodemailer": "^6.10.0",
    "pdfkit": "^0.20.2",
    "pino": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.14.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "undici": "^7.3.0",
    "xmlbuilder2": "^3.1.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/sanitize-html": "^2.13.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.3.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
